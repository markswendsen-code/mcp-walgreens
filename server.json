{
  "mcpName": "io.github.markswendsen-code/walgreens",
  "name": "@striderlabs/mcp-walgreens",
  "version": "0.1.0",
  "description": "MCP server connector for Walgreens — search products, manage prescriptions, cart, and checkout via browser automation",
  "transport": "stdio",
  "command": "npx",
  "args": ["@striderlabs/mcp-walgreens"],
  "tools": [
    "status",
    "login",
    "logout",
    "search",
    "get_product",
    "check_prescription_status",
    "refill_prescription",
    "add_to_cart",
    "view_cart",
    "remove_from_cart",
    "set_store",
    "check_store_availability",
    "checkout"
  ],
  "repository": "https://github.com/markswendsen-code/mcp-walgreens",
  "npm": "https://www.npmjs.com/package/@striderlabs/mcp-walgreens",
  "author": "Strider Labs <hello@striderlabs.ai>",
  "homepage": "https://striderlabs.ai",
  "license": "MIT",
  "keywords": ["mcp", "walgreens", "pharmacy", "prescriptions", "healthcare", "ai-agent"]
}
